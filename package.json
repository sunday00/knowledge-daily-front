{
  "name": "knowledge-daily-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen:pre": "bash scripts/codegen-pre.sh",
    "codegen": "pnpm codegen:pre && graphql-codegen",
    "codegen:watch": "pnpm codegen:pre && graphql-codegen --watch"
  },
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@jsquash/webp": "^1.5.0",
    "firebase": "^13.0.0",
    "graphql": "^16.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@unocss/preset-typography": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "@vitejs/plugin-react": "^4.3.2",
    "prettier": "^3.9.10",
    "simple-icons": "^16.35.0",
    "typescript": "^5.6.2",
    "unocss": "^66.11.0",
    "vite": "^5.4.8"
  }
}
