VITE_SITE_URL=http://localhost:5080

VITE_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Kakao OAuth (Authorization Code flow)
# 콘솔(Kakao Developers)에서 Web 플랫폼 도메인과 Redirect URI를 반드시 등록해야 합니다.
VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key
VITE_KAKAO_REDIRECT_URI=http://localhost:5080/auth/kakao/callback

# Firebase Cloud Messaging (Web Push)
# Firebase 콘솔 > 프로젝트 설정 > 일반 (웹 앱) / 클라우드 메시징 > 웹 푸시 인증서(VAPID)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key
